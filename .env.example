# Base config
DATABASE_URL=postgresql://hh4you:your-password@localhost:5432/hh4you
SECRET_KEY=generate-a-secure-secret-key-for-jwt-tokens-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Global Admin LLM Configuration (OpenAI-compatible)
# E.g. for OpenAI: https://api.openai.com/v1
# E.g. for OpenRouter: https://openrouter.ai/api/v1
# E.g. for GigaChat: https://api.giga.chat/v1
# E.g. for local Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-global-openai-or-other-llm-api-key
LLM_MODEL_NAME=gpt-4o-mini
# Note for Sber GigaChat: Use GigaChat-2-Pro model and pass your Base64 encoded ClientID:ClientSecret in LLM_API_KEY.

# Optional proxy configuration for LLM requests (e.g. if OpenRouter/OpenAI is blocked or times out in your region)
# HTTPS_PROXY=http://127.0.0.1:7890

# SuperJob API Credentials (REQUIRED for SuperJob API)
# Register at: https://api.superjob.ru/
SUPERJOB_API_KEY=your-superjob-api-app-id

# YooKassa Payment Gateway
# Get credentials at: https://yookassa.ru/my -> Интеграция -> Ключи API
# Test mode: use test shopId / secretKey from YooKassa dashboard
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_AMOUNT=300.00
YOOKASSA_CURRENCY=RUB
# Set to false to switch to live payments (real money)
YOOKASSA_TEST_MODE=true

# Global Admin SMTP Configuration (for vacancy and billing alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=your-email-smtp-password
SMTP_FROM_EMAIL=notifications@yourdomain.com

# Scans frequency (in minutes)
SCAN_INTERVAL_MINUTES=15

# Global vacancy description cache settings
VACANCY_CACHE_MAX_SIZE=1000
VACANCY_CACHE_TTL_MINUTES=120

# Web App Base URL
BASE_URL=http://localhost:8000

# Proxy Support
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Guest scenario config (paywall or trial)
GUEST_FLOW_SCENARIO=paywall
GUEST_TRIAL_DAYS=7

